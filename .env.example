# GEMINI_API_KEY: Required for server-side Gemini AI medication insights, prescription parsing, and doctor visit briefs.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional SMTP Configuration for Live Proactive Email Delivery (Nodemailer)
# When omitted in local/preview environments, emails are rendered and logged in the Care Circle Outbox.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="KinCare Alerts <alerts@kincare.example.com>"
